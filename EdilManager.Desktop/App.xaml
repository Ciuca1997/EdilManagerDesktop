<Application x:Class="EdilManager.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:EdilManager.Desktop"
             xmlns:vm="clr-namespace:EdilManager.Desktop.ViewModels"
             xmlns:views="clr-namespace:EdilManager.Desktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="LightBlue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:StringToVisibilityConverter x:Key="HasText" />

            <SolidColorBrush x:Key="SidebarBackground" Color="#F3F5FA" />
            <SolidColorBrush x:Key="AvatarBackground" Color="#D6E3FF" />
            <SolidColorBrush x:Key="AvatarForeground" Color="#0B2E63" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />
            <SolidColorBrush x:Key="WarningBrush" Color="#EF6C00" />
            <SolidColorBrush x:Key="MutedBrush" Color="#5F6368" />
            <SolidColorBrush x:Key="DividerBrush" Color="#1F000000" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Setter Property="Margin" Value="0,8,0,12" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            </Style>

            <Style x:Key="FieldValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="8,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="8" Padding="12,10" Background="Transparent" Cursor="Hand">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AvatarBackground}" />
                                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource AvatarForeground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>

            <!-- Il ContentPresenter della cella si restringe al contenuto: senza questo l'importo resta a sinistra -->
            <Style x:Key="RightCellContainer" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>

            <Style x:Key="RightCell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FattureViewModel}">
                <views:FattureView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FatturaDetailViewModel}">
                <views:FatturaDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CantieriViewModel}">
                <views:CantieriView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CantiereDetailViewModel}">
                <views:CantiereDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImpostazioniViewModel}">
                <views:ImpostazioniView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FornitoriViewModel}">
                <views:FornitoriView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FornitoreDetailViewModel}">
                <views:FornitoreDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CantiereFormViewModel}">
                <views:CantiereFormView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DipendentiViewModel}">
                <views:DipendentiView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DipendenteDetailViewModel}">
                <views:DipendenteDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DipendenteFormViewModel}">
                <views:DipendenteFormView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PresenzaFormViewModel}">
                <views:PresenzaFormView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfirmViewModel}">
                <views:ConfirmView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImportProgressViewModel}">
                <views:ImportProgressView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UpdateViewModel}">
                <views:UpdateView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
