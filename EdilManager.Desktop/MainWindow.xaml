<Window x:Class="EdilManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="EdilManager" Height="780" Width="1240" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontSize="14"
        FontFamily="Segoe UI">
    <materialDesign:DialogHost Identifier="RootDialog" DialogTheme="Inherit" CloseOnClickAway="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Background="{StaticResource SidebarBackground}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="16,20">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Domain" Width="32" Height="32" Foreground="White" />
                        <TextBlock Text="EdilManager" Margin="0,8,0,0" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Edilizia Matenana" FontSize="12" Foreground="White" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                    <Button Command="{Binding CheckUpdatesCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalContentAlignment="Left" Foreground="{StaticResource MutedBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                            <TextBlock Text="Controlla aggiornamenti" Margin="8,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding VersionText}" Margin="16,2,0,0" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <ListBox Margin="0,8,0,0" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

            <ContentControl Grid.Column="2" Content="{Binding CurrentPage}" />
        </Grid>
    </materialDesign:DialogHost>
</Window>
