<Window x:Class="EdilManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding TitoloFinestra}" Icon="Assets/icona.ico" Height="780" Width="1240" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontSize="14"
        FontFamily="Segoe UI">
    <materialDesign:DialogHost Identifier="RootDialog" DialogTheme="Inherit" CloseOnClickAway="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Background="{StaticResource SidebarBackground}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="16,20">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Domain" Width="32" Height="32" Foreground="White" />
                        <!-- Il nome dell'azienda (o "EdilManager" finché i dati non sono stati inseriti); su più righe se lungo. -->
                        <TextBlock Text="{Binding NomeAzienda}" ToolTip="{Binding NomeAzienda}" Margin="0,8,0,0" FontSize="17"
                                   FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxHeight="48" />
                        <TextBlock Text="{Binding PartitaIvaTesto}" Margin="0,2,0,0" FontSize="12" Foreground="White" Opacity="0.8"
                                   Visibility="{Binding HasPartitaIva, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12">
                    <ListBox ItemsSource="{Binding BottomNavItems}"
                             SelectedItem="{Binding SelectedBottomItem}"
                             ItemContainerStyle="{StaticResource NavListBoxItem}"
                             Background="Transparent" BorderThickness="0" Margin="0,0,0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Margin="12,0,12,0" Command="{Binding CheckUpdatesCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalContentAlignment="Left" Foreground="{StaticResource MutedBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                            <TextBlock Text="Controlla aggiornamenti" Margin="8,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding VersionText}" Margin="28,2,0,0" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <ListBox Margin="0,8,0,0" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

            <ContentControl Grid.Column="2" Content="{Binding CurrentPage}" />
        </Grid>
    </materialDesign:DialogHost>
</Window>
