<UserControl x:Class="EdilManager.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
        </Border>

        <Grid>
            <TextBlock Text="{Binding ErrorMessage, StringFormat=Errore: {0}}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Cards}" Margin="24,24,8,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260" Margin="0,0,16,16" Padding="20" CornerRadius="12"
                                    Background="{StaticResource SidebarBackground}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{StaticResource AvatarBackground}">
                                            <materialDesign:PackIcon Kind="{Binding Icon}" Width="22" Height="22"
                                                                     Foreground="{StaticResource AvatarForeground}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" Margin="0,16,0,0" FontSize="34"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"
                                               Visibility="{Binding Detail, Converter={StaticResource HasText}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
