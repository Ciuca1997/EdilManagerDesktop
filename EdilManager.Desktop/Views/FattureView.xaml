<UserControl x:Class="EdilManager.Desktop.Views.FattureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="24,16">
            <TextBlock Text="Fatture" Style="{StaticResource PageTitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"
                        Command="{Binding ExportCommand}"
                        ToolTip="Copia in una cartella le fatture di un anno o di un periodo, divise per cantiere e fornitore">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderArrowDownOutline" VerticalAlignment="Center" />
                        <TextBlock Text="Esporta" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding ImportFolderCommand}"
                        ToolTip="{Binding CartellaImportazioneTesto}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderSearchOutline" VerticalAlignment="Center" />
                        <TextBlock Text="Importa cartella" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MaterialDesignIconButton}" Margin="2,0,8,0" Width="36" Height="36"
                        Command="{Binding ImportOtherFolderCommand}"
                        ToolTip="Importa da un'altra cartella, solo questa volta">
                    <materialDesign:PackIcon Kind="FolderOpenOutline" />
                </Button>
                <Button Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileUploadOutline" VerticalAlignment="Center" />
                        <TextBlock Text="Importa fatture" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

        <Grid DockPanel.Dock="Top" Margin="24,12,24,0">
            <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Filtri}"
                      SelectedItem="{Binding Filtro}" DisplayMemberPath="Testo"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Stato" />
            <TextBlock Text="{Binding RiepilogoElenco}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" />
        </Grid>

        <Grid Margin="24,8,24,16">
            <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding ErrorMessage, StringFormat=Errore: {0}}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Nessuna fattura." HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Usa «Importa fatture» per caricare file XML (FatturaPA) o PDF, oppure «Importa cartella» per leggere in un colpo solo una cartella e le sue sottocartelle (la prima volta ti chiede quale)."
                           Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <TextBlock Text="Nessuna fattura con questo stato." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding NessunRisultato, Converter={StaticResource BoolToVis}}" />

            <DataGrid x:Name="Griglia" PreviewMouseRightButtonDown="OnGrigliaRightClick" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Extended"
                      SelectionUnit="FullRow" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="Transparent" RowBackground="Transparent"
                      HorizontalGridLinesBrush="{StaticResource DividerBrush}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Segna come pagata…" Tag="Pagata" Click="OnImpostaStato" />
                        <MenuItem Header="Segna come da pagare" Tag="DaPagare" Click="OnImpostaStato" />
                        <MenuItem Header="Segna come in contestazione" Tag="InContestazione" Click="OnImpostaStato" />
                        <Separator />
                        <MenuItem Header="Assegna cantiere…" Click="OnAssegnaCantiere" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="120" />
                    <DataGridTextColumn Header="Numero" Binding="{Binding Numero}" Width="110" />
                    <DataGridTextColumn Header="Fornitore" Binding="{Binding Fornitore}" Width="*" />
                    <DataGridTextColumn Header="Cantiere" Binding="{Binding Cantiere}" Width="*" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70" />
                    <DataGridTextColumn Header="Totale" Binding="{Binding Totale}" Width="130"
                                        HeaderStyle="{StaticResource RightHeader}"
                                        ElementStyle="{StaticResource RightCell}"
                                        CellStyle="{StaticResource RightCellContainer}" />
                    <DataGridTextColumn Header="Scadenza" Binding="{Binding Scadenza}" Width="110" />
                    <DataGridTextColumn Header="Stato" Binding="{Binding StatoTesto}" Width="160"
                                        ElementStyle="{StaticResource StatoFatturaText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
