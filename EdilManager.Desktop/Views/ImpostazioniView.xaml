<UserControl x:Class="EdilManager.Desktop.Views.ImpostazioniView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <TextBlock Text="Impostazioni" Style="{StaticResource PageTitle}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16" MaxWidth="820" HorizontalAlignment="Left">
                <Border CornerRadius="10" Padding="20" Background="{StaticResource SidebarBackground}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Archivio fatture" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                           Text="Quando importi delle fatture, ne copia i file (XML e PDF) in una cartella a tua scelta. Le fatture già presenti nel programma vengono copiate se mancano nella cartella." />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" VerticalAlignment="Top" Margin="16,2,0,0"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          ToolTip="Attiva o disattiva la copia delle fatture importate"
                                          IsChecked="{Binding ArchivioAttivo, Mode=OneWay}"
                                          Command="{Binding ToggleArchivioCommand}"
                                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                        </Grid>

                        <TextBlock Text="CARTELLA DI DESTINAZIONE" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CartellaArchivio}" ToolTip="{Binding CartellaArchivio}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       Text="Nessuna cartella scelta"
                                       Visibility="{Binding NoCartella, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="1" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ScegliCartellaCommand}" Content="Scegli cartella…" />
                            <Button Grid.Column="2" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ApriCartellaCommand}" Content="Apri"
                                    Visibility="{Binding HasCartella, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Text="{Binding ErrorMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource DangerBrush}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="COME SONO ORGANIZZATI I FILE" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" LineHeight="22">
                            <Run Text="fornitori\" FontWeight="SemiBold" /><Run Text="Nome fornitore\" /><Run Text="2024-08-09 Nome fornitore - 2089.pdf" FontStyle="Italic" />
                            <LineBreak />
                            <Run Text="cantieri\" FontWeight="SemiBold" /><Run Text="Nome cantiere\" /><Run Text="2024-08-09 Nome fornitore - 2089.pdf" FontStyle="Italic" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Text="La copia nella cartella del cantiere avviene solo per le fatture che hanno un cantiere. Se rinomini un cantiere, ne viene rinominata anche la cartella. I file già presenti non vengono mai sovrascritti." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
