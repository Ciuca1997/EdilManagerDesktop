<UserControl x:Class="EdilManager.Desktop.Views.ImpostazioniView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <TextBlock Text="Impostazioni" Style="{StaticResource PageTitle}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="{Binding ErrorMessage}" Margin="0,0,0,12" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <Border CornerRadius="10" Padding="20" Margin="0,0,0,16" Background="{StaticResource SidebarBackground}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Azienda" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                           Text="Il nome compare in alto a sinistra e nell'intestazione dei fogli presenze in PDF." />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ModificaAziendaCommand}" Content="{Binding TestoPulsanteAzienda}" />
                        </Grid>

                        <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="Nessun dato inserito."
                                   Visibility="{Binding NoAzienda, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasAzienda, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AziendaNome}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AziendaDettagli}" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border CornerRadius="10" Padding="20" Background="{StaticResource SidebarBackground}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Archivio fatture" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                           Text="Quando importi delle fatture, ne copia i file (XML e PDF) in una cartella a tua scelta. Le fatture già presenti nel programma vengono copiate se mancano nella cartella." />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" VerticalAlignment="Top" Margin="16,2,0,0"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          ToolTip="Attiva o disattiva la copia delle fatture importate"
                                          IsChecked="{Binding ArchivioAttivo, Mode=OneWay}"
                                          Command="{Binding ToggleArchivioCommand}"
                                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                        </Grid>

                        <TextBlock Text="CARTELLA DI DESTINAZIONE" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CartellaArchivio}" ToolTip="{Binding CartellaArchivio}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       Text="Nessuna cartella scelta"
                                       Visibility="{Binding NoCartella, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="1" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ScegliCartellaCommand}" Content="Scegli cartella…" />
                            <Button Grid.Column="2" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ApriCartellaCommand}" Content="Apri"
                                    Visibility="{Binding HasCartella, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Text="COME SONO ORGANIZZATI I FILE" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
                        <TextBlock TextWrapping="Wrap" LineHeight="22">
                            <Run Text="fornitori\" FontWeight="SemiBold" /><Run Text="Nome fornitore\" /><Run Text="2024-08-09 Nome fornitore - 2089.pdf" FontStyle="Italic" />
                            <LineBreak />
                            <Run Text="cantieri\" FontWeight="SemiBold" /><Run Text="Nome cantiere\" /><Run Text="2024-08-09 Nome fornitore - 2089.pdf" FontStyle="Italic" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Text="La copia nella cartella del cantiere avviene solo per le fatture che hanno un cantiere. Se rinomini un cantiere, ne viene rinominata anche la cartella. I file già presenti non vengono mai sovrascritti." />
                    </StackPanel>
                </Border>

                <Border CornerRadius="10" Padding="20" Margin="0,16,0,0" Background="{StaticResource SidebarBackground}">
                    <StackPanel>
                        <TextBlock Text="Importazione fatture" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Cartella da cui «Importa cartella» legge le fatture con un solo clic (anche le sottocartelle). Se non la scegli qui, te la chiede la prima volta; se non esiste più, te ne chiede un'altra." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CartellaImportazione}" ToolTip="{Binding CartellaImportazione}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       Text="Nessuna cartella scelta"
                                       Visibility="{Binding NoCartellaImportazione, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="1" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ScegliCartellaImportazioneCommand}" Content="Scegli cartella…" />
                            <Button Grid.Column="2" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ApriCartellaImportazioneCommand}" Content="Apri"
                                    Visibility="{Binding HasCartellaImportazione, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="3" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding TogliCartellaImportazioneCommand}" Content="Togli"
                                    ToolTip="Dimentica la cartella: la prossima volta verrà richiesta"
                                    Visibility="{Binding HasCartellaImportazione, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                   Text="{Binding AvvisoSovrapposizione}"
                                   Visibility="{Binding HasAvvisoSovrapposizione, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="10" Padding="20" Margin="0,16,0,0" Background="{StaticResource SidebarBackground}">
                    <StackPanel>
                        <TextBlock Text="Esportazioni" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Cartella in cui si apre il salvataggio dei fogli presenze (PDF e CSV). Il nome del file resta da confermare ogni volta, così non si sovrascrive nulla per sbaglio. Se non la scegli, Windows riapre l'ultima cartella usata." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding CartellaEsportazione}" ToolTip="{Binding CartellaEsportazione}" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       Text="Nessuna cartella scelta"
                                       Visibility="{Binding NoCartellaEsportazione, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="1" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ScegliCartellaEsportazioneCommand}" Content="Scegli cartella…" />
                            <Button Grid.Column="2" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ApriCartellaEsportazioneCommand}" Content="Apri"
                                    Visibility="{Binding HasCartellaEsportazione, Converter={StaticResource BoolToVis}}" />
                            <Button Grid.Column="3" Margin="8,0,0,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding TogliCartellaEsportazioneCommand}" Content="Togli"
                                    Visibility="{Binding HasCartellaEsportazione, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
