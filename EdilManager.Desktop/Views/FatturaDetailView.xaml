<UserControl x:Class="EdilManager.Desktop.Views.FatturaDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,12,24,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Indietro"
                        Command="{Binding GoBackCommand}">
                    <materialDesign:PackIcon Kind="ArrowLeft" />
                </Button>
                <TextBlock Text="{Binding Titolo}" Style="{StaticResource PageTitle}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="FORNITORE" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                        <Hyperlink Command="{Binding OpenFornitoreCommand}" ToolTip="Apri il fornitore">
                            <Run Text="{Binding Fornitore, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding PartitaIva, StringFormat=P.IVA {0}}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CodiceFiscale, StringFormat=C.F. {0}}" Margin="0,2,0,0"
                               Visibility="{Binding CodiceFiscale, Converter={StaticResource HasText}}" />
                    <TextBlock Text="{Binding Indirizzo}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding Indirizzo, Converter={StaticResource HasText}}" />
                    <TextBlock Text="{Binding Email}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding Email, Converter={StaticResource HasText}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="DOCUMENTO" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Data" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Data}" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Tipo documento" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Tipo}" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Cantiere" Style="{StaticResource FieldLabel}" />
                        <TextBlock Style="{StaticResource FieldValue}"
                                   Visibility="{Binding Cantiere, Converter={StaticResource HasText}}">
                            <Hyperlink Command="{Binding OpenCantiereCommand}" ToolTip="Apri il cantiere">
                                <Run Text="{Binding Cantiere, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Nessun cantiere"
                                   Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCantiere}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="Assegna cantiere…" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding AssegnaCantiereCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="PAGAMENTO" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <StackPanel Margin="0,0,0,6" Visibility="{Binding Pagamento, Converter={StaticResource HasText}}">
                        <TextBlock Text="Modalità" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Pagamento}" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6" Visibility="{Binding Scadenza, Converter={StaticResource HasText}}">
                        <TextBlock Text="Scadenza" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Scadenza}" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6" Visibility="{Binding ScadenzaPresunta, Converter={StaticResource HasText}}">
                        <TextBlock Text="Scadenza" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ScadenzaPresunta}" Style="{StaticResource FieldValue}"
                                   ToolTip="Il documento non indica la scadenza: è la data della fattura più i giorni impostati in Impostazioni." />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6" Visibility="{Binding ImportoPagamento, Converter={StaticResource HasText}}">
                        <TextBlock Text="Importo" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ImportoPagamento}" Style="{StaticResource FieldValue}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasStato, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Stato" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding StatoTesto}" Style="{StaticResource StatoFatturaText}" FontSize="16" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Segna pagata…" Margin="0,0,8,4" Command="{Binding SegnaPagataCommand}"
                                    IsEnabled="{Binding CanSegnaPagata}" />
                            <Button Content="Da pagare" Margin="0,0,8,4" Command="{Binding SegnaDaPagareCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    IsEnabled="{Binding CanSegnaDaPagare}" />
                            <Button Content="In contestazione" Margin="0,0,0,4" Command="{Binding SegnaContestataCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    IsEnabled="{Binding CanSegnaContestata}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

        <DockPanel Margin="24,16,24,16">
            <TextBlock DockPanel.Dock="Top" Text="Righe" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="16,10"
                    BorderBrush="{StaticResource DividerBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Imponibile: " Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding TotaleImponibile}" FontWeight="SemiBold" />
                    <TextBlock Text="IVA: " Margin="24,0,0,0" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding TotaleImposta}" FontWeight="SemiBold" />
                    <TextBlock Text="Totale documento: " Margin="24,0,0,0" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding TotaleDocumento}" FontWeight="Bold" FontSize="15" />
                </StackPanel>
            </Border>

            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding NoRighe, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nessuna riga di dettaglio disponibile." HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="Per le fatture importate da PDF le righe non sempre si riescono a leggere: importa il file XML per vederle."
                               Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Righe}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionUnit="FullRow" GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="Transparent" RowBackground="Transparent"
                          HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          Visibility="{Binding HasRighe, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Codice" Binding="{Binding Codice}" Width="Auto" MaxWidth="140" />
                        <DataGridTextColumn Header="Descrizione" Binding="{Binding Descrizione}" Width="*" MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Quantità" Binding="{Binding Quantita}" Width="Auto"
                                            HeaderStyle="{StaticResource RightHeader}"
                                            ElementStyle="{StaticResource RightCell}"
                                            CellStyle="{StaticResource RightCellContainer}" />
                        <DataGridTextColumn Header="Prezzo unit." Binding="{Binding PrezzoUnitario}" Width="Auto"
                                            HeaderStyle="{StaticResource RightHeader}"
                                            ElementStyle="{StaticResource RightCell}"
                                            CellStyle="{StaticResource RightCellContainer}" />
                        <DataGridTextColumn Header="Sconto" Binding="{Binding Sconto}" Width="Auto"
                                            HeaderStyle="{StaticResource RightHeader}"
                                            ElementStyle="{StaticResource RightCell}"
                                            CellStyle="{StaticResource RightCellContainer}" />
                        <DataGridTextColumn Header="IVA" Binding="{Binding Iva}" Width="Auto"
                                            HeaderStyle="{StaticResource RightHeader}"
                                            ElementStyle="{StaticResource RightCell}"
                                            CellStyle="{StaticResource RightCellContainer}" />
                        <DataGridTextColumn Header="Totale (€)" Binding="{Binding Totale}" Width="Auto"
                                            HeaderStyle="{StaticResource RightHeader}"
                                            ElementStyle="{StaticResource RightCell}"
                                            CellStyle="{StaticResource RightCellContainer}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
