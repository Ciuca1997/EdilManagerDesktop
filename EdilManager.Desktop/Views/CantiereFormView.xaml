<UserControl x:Class="EdilManager.Desktop.Views.CantiereFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="440">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titolo}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,12,0,16" Foreground="{StaticResource MutedBrush}"
                   Visibility="{Binding HasCup, Converter={StaticResource BoolToVis}}">
            <Run Text="CUP:" />
            <Run Text="{Binding Cup, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Margin="0,12,0,16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="{Binding Descrizione}"
                   Visibility="{Binding HasDescrizione, Converter={StaticResource BoolToVis}}" />

        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                 materialDesign:HintAssist.Hint="Nome del cantiere" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annulla" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding CancelCommand}" />
            <Button Content="Salva" Margin="12,0,0,0" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
