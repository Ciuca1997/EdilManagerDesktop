<UserControl x:Class="EdilManager.Desktop.Views.DipendentiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="24,16">
            <TextBlock Text="Dipendenti" Style="{StaticResource PageTitle}" />
            <Button HorizontalAlignment="Right" Command="{Binding NewCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                    <TextBlock Text="Nuovo" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

        <Grid>
            <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="48" Height="48"
                                         Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage, StringFormat=Errore: {0}}" Margin="0,12" TextWrapping="Wrap"
                           MaxWidth="500" TextAlignment="Center" />
                <Button Content="Riprova" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="OnRetryClick" HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Nessun dipendente trovato." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}" Margin="24,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Margin="0,0,0,6" Background="{StaticResource SidebarBackground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="Auto" Padding="12,10"
                                            HorizontalContentAlignment="Left"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    Background="{StaticResource AvatarBackground}">
                                                <TextBlock Text="{Binding Iniziale}" FontWeight="Bold"
                                                           Foreground="{StaticResource AvatarForeground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NomeCompleto}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Sottotitolo}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Visibility="{Binding Sottotitolo, Converter={StaticResource HasText}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modifica"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" />
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Elimina"
                                                Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
