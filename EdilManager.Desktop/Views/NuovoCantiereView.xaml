<UserControl x:Class="EdilManager.Desktop.Views.NuovoCantiereView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="480">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titolo}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
            <Run Text="È comparso il CUP" />
            <Run Text="{Binding Cup, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="per la prima volta, in questa fattura:" />
        </TextBlock>

        <Border CornerRadius="8" Padding="14,10" Margin="0,12,0,16" Background="{StaticResource SidebarBackground}">
            <StackPanel>
                <TextBlock Text="{Binding Fornitore}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0">
                    <Run Text="Fattura" />
                    <Run Text="{Binding Fattura, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Totale, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="{Binding Descrizione}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding Descrizione, Converter={StaticResource HasText}}" />
            </StackPanel>
        </Border>

        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                 materialDesign:HintAssist.Hint="Nome del cantiere" />
        <TextBlock Text="La cartella dell'archivio fatture prenderà questo nome." Margin="0,6,0,0" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <Grid Margin="0,24,0,0">
            <Button Content="Salta tutti" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding SkipAllCommand}"
                    ToolTip="Lascia tutti i cantieri senza nome: si possono rinominare dalla pagina Cantieri"
                    Visibility="{Binding PiuDiUno, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Più tardi" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{Binding LaterCommand}" />
                <Button Content="Salva" Margin="12,0,0,0" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
