<UserControl x:Class="EdilManager.Desktop.Views.PresenzaGiornoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="640">
    <StackPanel Margin="24">
        <TextBlock Text="Presenze del giorno" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Sottotitolo}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                   Text="Una riga per cantiere: così le ore di un giorno si possono dividere tra più cantieri. Lascia vuote le ore per togliere una riga." />

        <ItemsControl ItemsSource="{Binding Righe}" Margin="0,16,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding DataContext.Cantieri, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding Cantiere}" DisplayMemberPath="Nome"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Cantiere" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding OreOrdinarie, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ore ord." />
                        <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding OreStraordinarie, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ore straord." />
                        <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}" ToolTip="Togli questa riga"
                                Margin="4,0,0,0" VerticalAlignment="Center"
                                Foreground="{StaticResource DangerBrush}"
                                Command="{Binding DataContext.RimuoviRigaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="DeleteOutline" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button HorizontalAlignment="Left" Style="{StaticResource MaterialDesignOutlinedButton}"
                Command="{Binding AggiungiRigaCommand}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                <TextBlock Text="Aggiungi cantiere" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annulla" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding CancelCommand}" />
            <Button Content="Salva" Margin="12,0,0,0" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
