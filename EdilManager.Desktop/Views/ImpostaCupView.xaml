<UserControl x:Class="EdilManager.Desktop.Views.ImpostaCupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="440">
    <StackPanel Margin="24">
        <TextBlock Text="Imposta il CUP" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,10,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
            <Run Text="Cantiere:" />
            <Run Text="{Binding Nome, Mode=OneWay}" FontWeight="SemiBold" />
            <LineBreak />
            <Run Text="Le fatture già assegnate restano collegate; le prossime con questo CUP finiranno qui da sole." />
        </TextBlock>

        <TextBox Text="{Binding Cup, UpdateSourceTrigger=PropertyChanged}" MaxLength="15"
                 CharacterCasing="Upper" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                 materialDesign:HintAssist.Hint="CUP (15 caratteri)" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annulla" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding CancelCommand}" />
            <Button Content="Salva" Margin="12,0,0,0" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
