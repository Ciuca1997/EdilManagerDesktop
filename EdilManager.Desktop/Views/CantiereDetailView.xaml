<UserControl x:Class="EdilManager.Desktop.Views.CantiereDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,12,24,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Indietro"
                        Command="{Binding GoBackCommand}">
                    <materialDesign:PackIcon Kind="ArrowLeft" />
                </Button>
                <TextBlock Text="{Binding Nome}" Style="{StaticResource PageTitle}" Margin="8,0,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding RenameCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PencilOutline" VerticalAlignment="Center" />
                    <TextBlock Text="Rinomina" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}" Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,48,0">
                    <TextBlock Text="CUP" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Cup}" Style="{StaticResource FieldValue}" />
                </StackPanel>
                <StackPanel Margin="0,0,48,0">
                    <TextBlock Text="Fatture" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding FattureText}" Style="{StaticResource FieldValue}" />
                </StackPanel>
                <StackPanel Margin="0,0,48,0">
                    <TextBlock Text="Totale fatturato (note di credito sottratte)" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Totale}" FontSize="16" FontWeight="Bold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Ore lavorate" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding OreText}" FontSize="16" FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

        <Grid Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,16" Visibility="{Binding HasFatture, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Fornitori" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Fornitori}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                              SelectionUnit="FullRow" GridLinesVisibility="Horizontal" BorderThickness="0"
                              Background="Transparent" RowBackground="Transparent" MaxHeight="216"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="OnFornitoreDoubleClick" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="ToolTip" Value="Doppio clic per aprire il fornitore" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fornitore" Binding="{Binding Denominazione}" Width="*" />
                            <DataGridTextColumn Header="Fatture" Binding="{Binding Fatture}" Width="80"
                                                HeaderStyle="{StaticResource RightHeader}"
                                                ElementStyle="{StaticResource RightCell}"
                                                CellStyle="{StaticResource RightCellContainer}" />
                            <DataGridTextColumn Header="Totale" Binding="{Binding Totale}" Width="130"
                                                HeaderStyle="{StaticResource RightHeader}"
                                                ElementStyle="{StaticResource RightCell}"
                                                CellStyle="{StaticResource RightCellContainer}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,16"
                            Visibility="{Binding HasManodopera, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Manodopera" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Manodopera}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                              SelectionUnit="FullRow" GridLinesVisibility="Horizontal" BorderThickness="0"
                              Background="Transparent" RowBackground="Transparent" MaxHeight="216"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <EventSetter Event="MouseDoubleClick" Handler="OnDipendenteDoubleClick" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="ToolTip" Value="Doppio clic per aprire il dipendente" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dipendente" Binding="{Binding Dipendente}" Width="*" />
                            <DataGridTextColumn Header="Giorni" Binding="{Binding Giorni}" Width="70"
                                                HeaderStyle="{StaticResource RightHeader}"
                                                ElementStyle="{StaticResource RightCell}"
                                                CellStyle="{StaticResource RightCellContainer}" />
                            <DataGridTextColumn Header="Ore ord." Binding="{Binding OreOrdinarie}" Width="90"
                                                HeaderStyle="{StaticResource RightHeader}"
                                                ElementStyle="{StaticResource RightCell}"
                                                CellStyle="{StaticResource RightCellContainer}" />
                            <DataGridTextColumn Header="Straord." Binding="{Binding OreStraordinarie}" Width="90"
                                                HeaderStyle="{StaticResource RightHeader}"
                                                ElementStyle="{StaticResource RightCell}"
                                                CellStyle="{StaticResource RightCellContainer}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="Fatture" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

                <TextBlock Text="Nessuna fattura associata a questo cantiere." HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding NoFatture, Converter={StaticResource BoolToVis}}" />

                <DataGrid ItemsSource="{Binding Fatture}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                          SelectionUnit="FullRow" GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="Transparent" RowBackground="Transparent"
                          HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          Visibility="{Binding HasFatture, Converter={StaticResource BoolToVis}}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <EventSetter Event="MouseDoubleClick" Handler="OnFatturaDoubleClick" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="Doppio clic per aprire la fattura" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="120" />
                        <DataGridTextColumn Header="Numero" Binding="{Binding Numero}" Width="130" />
                        <DataGridTextColumn Header="Fornitore" Binding="{Binding Fornitore}" Width="*" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70" />
                        <DataGridTextColumn Header="Totale" Binding="{Binding Totale}" Width="130"
                                            HeaderStyle="{StaticResource RightHeader}"
                                            ElementStyle="{StaticResource RightCell}"
                                            CellStyle="{StaticResource RightCellContainer}" />
                        <DataGridTextColumn Header="Scadenza" Binding="{Binding Scadenza}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
