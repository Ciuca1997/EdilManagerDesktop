<UserControl x:Class="EdilManager.Desktop.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="380" MaxWidth="480">
    <StackPanel Margin="24">
        <TextBlock Text="Aggiornamento disponibile" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
            <Run Text="È disponibile la versione" />
            <Run Text="{Binding Versione, Mode=OneWay}" FontWeight="Bold" /><Run Text="." />
            <Run Text="Vuoi aggiornare adesso? L'applicazione verrà riavviata." />
        </TextBlock>

        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Download in corso..." Foreground="{StaticResource MutedBrush}" />
            <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,16,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource HasText}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Più tardi" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding LaterCommand}" IsEnabled="{Binding CanChoose}" />
            <Button Content="Aggiorna ora" Margin="12,0,0,0" Command="{Binding UpdateNowCommand}"
                    IsEnabled="{Binding CanChoose}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
