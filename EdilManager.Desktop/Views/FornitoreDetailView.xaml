<UserControl x:Class="EdilManager.Desktop.Views.FornitoreDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,12,24,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Indietro"
                        Command="{Binding GoBackCommand}">
                    <materialDesign:PackIcon Kind="ArrowLeft" />
                </Button>
                <TextBlock Text="{Binding Titolo}" Style="{StaticResource PageTitle}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackground}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="ANAGRAFICA" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding PartitaIva, StringFormat=P.IVA {0}}" />
                    <TextBlock Text="{Binding CodiceFiscale, StringFormat=C.F. {0}}" Margin="0,2,0,0"
                               Visibility="{Binding CodiceFiscale, Converter={StaticResource HasText}}" />
                    <TextBlock Text="{Binding Indirizzo}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding Indirizzo, Converter={StaticResource HasText}}" />
                    <TextBlock Text="{Binding Email}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding Email, Converter={StaticResource HasText}}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="FATTURATO" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Fatture" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding FattureText}" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Totale (note di credito sottratte)" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Totale}" FontSize="16" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

        <DockPanel Margin="24,16,24,16">
            <TextBlock DockPanel.Dock="Top" Text="Fatture" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="Nessuna fattura per questo fornitore." HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding NoFatture, Converter={StaticResource BoolToVis}}" />

            <DataGrid ItemsSource="{Binding Fatture}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                      SelectionUnit="FullRow" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="Transparent" RowBackground="Transparent"
                      HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                      Visibility="{Binding HasFatture, Converter={StaticResource BoolToVis}}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <EventSetter Event="MouseDoubleClick" Handler="OnFatturaDoubleClick" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="Doppio clic per aprire la fattura" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="120" />
                    <DataGridTextColumn Header="Numero" Binding="{Binding Numero}" Width="130" />
                    <DataGridTextColumn Header="Cantiere" Binding="{Binding Cantiere}" Width="*" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70" />
                    <DataGridTextColumn Header="Totale" Binding="{Binding Totale}" Width="130"
                                        HeaderStyle="{StaticResource RightHeader}"
                                        ElementStyle="{StaticResource RightCell}"
                                        CellStyle="{StaticResource RightCellContainer}" />
                    <DataGridTextColumn Header="Scadenza" Binding="{Binding Scadenza}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>
