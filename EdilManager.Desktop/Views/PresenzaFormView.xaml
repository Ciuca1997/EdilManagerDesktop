<UserControl x:Class="EdilManager.Desktop.Views.PresenzaFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="400">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <DatePicker SelectedDate="{Binding Data}" DisplayDateStart="{Binding DisplayStart, Mode=OneWay}"
                    DisplayDateEnd="{Binding DisplayEnd, Mode=OneWay}" DisplayDate="{Binding DisplayStart, Mode=OneWay}"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                    materialDesign:HintAssist.Hint="Data" />
        <ComboBox Margin="0,16,0,0" ItemsSource="{Binding Cantieri}" SelectedItem="{Binding Cantiere}"
                  DisplayMemberPath="Nome" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                  materialDesign:HintAssist.Hint="Cantiere" />
        <TextBox Margin="0,16,0,0" Text="{Binding OreOrdinarie, UpdateSourceTrigger=PropertyChanged}"
                 PreviewTextInput="OnOrePreviewTextInput"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Ore ordinarie" />
        <TextBox Margin="0,16,0,0" Text="{Binding OreStraordinarie, UpdateSourceTrigger=PropertyChanged}"
                 PreviewTextInput="OnOrePreviewTextInput"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Ore straordinarie" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annulla" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding CancelCommand}" />
            <Button Content="{Binding SaveText}" Margin="12,0,0,0" Command="{Binding SaveCommand}"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
