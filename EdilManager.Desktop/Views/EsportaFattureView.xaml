<UserControl x:Class="EdilManager.Desktop.Views.EsportaFattureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="480">
    <StackPanel Margin="24">
        <TextBlock Text="Esporta fatture" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Text="Copia in una cartella i file delle fatture (XML e PDF) con la data della fattura nel periodo scelto." />

        <TextBlock Text="PERIODO (DATA DELLA FATTURA)" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <RadioButton Content="Anno" GroupName="Periodo" IsChecked="{Binding UsaAnno}" VerticalAlignment="Center"
                         MinWidth="90" />
            <ComboBox Grid.Column="1" Width="140" HorizontalAlignment="Left" ItemsSource="{Binding Anni}"
                      SelectedItem="{Binding Anno}" IsEnabled="{Binding UsaAnno}"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Anno" />
            <RadioButton Grid.Row="1" Content="Dal – al" GroupName="Periodo" IsChecked="{Binding UsaPeriodo}"
                         VerticalAlignment="Center" Margin="0,12,0,0" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0"
                        IsEnabled="{Binding UsaPeriodo}">
                <DatePicker Width="150" SelectedDate="{Binding Dal}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            materialDesign:HintAssist.Hint="Dal" />
                <DatePicker Width="150" Margin="12,0,0,0" SelectedDate="{Binding Al}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            materialDesign:HintAssist.Hint="Al" />
            </StackPanel>
        </Grid>

        <TextBlock Text="ORGANIZZAZIONE DELLE CARTELLE" Style="{StaticResource SectionTitle}" Margin="0,20,0,6" />
        <ComboBox ItemsSource="{Binding Divisioni}" SelectedItem="{Binding Divisione}" DisplayMemberPath="Testo"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Dividi per" />
        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Text="Le fatture senza cantiere vanno nella cartella «Senza cantiere»." />

        <CheckBox Content="Aggiungi un riepilogo in CSV (apribile con Excel)" Margin="0,16,0,0"
                  IsChecked="{Binding RiepilogoCsv}" />

        <Border CornerRadius="8" Padding="12,8" Margin="0,16,0,0" Background="{StaticResource SidebarBackground}"
                Visibility="{Binding ArchivioNonPronto, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarningBrush}"
                       Text="L'archivio fatture non è impostato (Impostazioni): i file originali non sono disponibili, quindi si può esportare solo il riepilogo." />
        </Border>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annulla" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Command="{Binding CancelCommand}" />
            <Button Content="Esporta…" Margin="12,0,0,0" Command="{Binding EsportaCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
