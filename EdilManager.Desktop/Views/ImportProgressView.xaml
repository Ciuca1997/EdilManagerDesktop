<UserControl x:Class="EdilManager.Desktop.Views.ImportProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="440" MaxWidth="560">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Titolo}" FontSize="20" FontWeight="SemiBold" />

        <ProgressBar Margin="0,20,0,0" Height="6" Minimum="0"
                     Maximum="{Binding Totale, Mode=OneWay}" Value="{Binding Elaborati, Mode=OneWay}"
                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
        <TextBlock Text="{Binding Conteggio}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding Stato}" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource MutedBrush}" />

        <Button Content="Annulla" HorizontalAlignment="Right" Margin="0,24,0,0"
                Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding CancelCommand}" />
    </StackPanel>
</UserControl>
