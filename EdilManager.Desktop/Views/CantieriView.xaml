<UserControl x:Class="EdilManager.Desktop.Views.CantieriView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,16" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid>
                <TextBlock Text="Cantieri" Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Width="300" VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="Cerca per CUP o nome"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="16,0,0,0" Command="{Binding NewCommand}"
                            ToolTip="Per un lavoro senza CUP">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" />
                            <TextBlock Text="Nuovo cantiere" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding ErrorMessage, StringFormat=Errore: {0}}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Nessun cantiere." HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="I cantieri vengono creati automaticamente importando fatture che contengono un CUP, oppure a mano con «Nuovo cantiere» se il lavoro non ha un CUP."
                           Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <TextBlock Text="Nessun cantiere corrisponde alla ricerca." HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}" Margin="24,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Margin="0,0,0,6" Padding="12,10" Cursor="Hand"
                                    ToolTip="Doppio clic per aprire il dettaglio"
                                    Background="{StaticResource SidebarBackground}">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="{StaticResource AvatarBackground}">
                                        <materialDesign:PackIcon Kind="Crane" Width="22" Height="22"
                                                                 Foreground="{StaticResource AvatarForeground}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                                            <TextBlock Text="da nominare" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}"
                                                       ToolTip="Il nome è ancora il CUP: usa la matita per dargli un nome"
                                                       Visibility="{Binding DaNominare, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                                            <Run Text="CUP:" />
                                            <Run Text="{Binding CupTesto, Mode=OneWay}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding FattureText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Rinomina" VerticalAlignment="Center"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="PencilOutline" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
